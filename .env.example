# ─────────────────────────────────────────────
# CV Checker — environment variables
# Copy this file to `.env.local` and fill in the values:
#   cp .env.example .env.local
# ─────────────────────────────────────────────

# Google Gemini (optional). GEMINI_API_KEY and GEMINI_MODEL must be set together.
# Get a key from https://aistudio.google.com/apikey
# Without them, the app uses a conservative deterministic extraction fallback.
GEMINI_API_KEY=
GEMINI_MODEL=

# Public base URL of the app
APP_URL=http://localhost:3000

# AI request timeout (milliseconds) and output token limit
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=1200

# Maximum CV upload size in bytes (default 5 MB)
MAX_UPLOAD_BYTES=5242880
